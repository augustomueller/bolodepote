{
  "name": "bolodepote-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "db": "json-server --watch db.json --port 3001",
    "api": "tsx watch src/server.ts",
    "dev": "concurrently -n db,api -c magenta,cyan \"npm:db\" \"npm:api\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:reset": "node -e \"require('fs').copyFileSync('db.seed.json','db.json')\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "json-server": "^0.17.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
